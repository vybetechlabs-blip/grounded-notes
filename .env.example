# Copy to .env and fill in what you need. Everything is OPTIONAL —
# the app runs fully keyless with local embeddings + extractive answers.

# ----- Generation provider -----
# auto (default): use Claude if ANTHROPIC_API_KEY is set, else OpenAI if
#                 OPENAI_API_KEY is set, else the keyless extractive answerer.
# Force one of: extractive | anthropic | openai
RAGKIT_PROVIDER=auto

# Cloud keys are not read from this file. To use a model-backed provider
# locally, install the extra (`uv sync --extra cloud`) and set ANTHROPIC_API_KEY
# (or OPENAI_API_KEY) in your shell environment. This file only carries the
# RAGKIT_* settings below.

# ----- Retrieval tuning (defaults shown) -----
# RAGKIT_TOP_K=5
# RAGKIT_MIN_SCORE=0.35        # grounding: min cosine similarity
# RAGKIT_MIN_COVERAGE=0.4      # grounding: min IDF-weighted term coverage
# RAGKIT_RERANK=false          # optional cross-encoder rerank (measure first!)

# ----- Paths (defaults shown) -----
# RAGKIT_CORPUS_DIR=corpus
# RAGKIT_DATA_DIR=data
